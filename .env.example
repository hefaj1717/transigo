# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (TEST MODE ONLY — the server refuses anything but sk_test_ / rk_test_)
# STRIPE_SECRET_KEY: Dashboard (Test mode) → Developers → API keys → Secret key
# STRIPE_WEBHOOK_SECRET: locally printed by `stripe listen`; on Vercel the endpoint's signing secret (whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stage 4 (Stripe Connect)
STRIPE_CONNECT_WEBHOOK_SECRET=

# Periodic job /api/cron/expire-orders: "Authorization: Bearer $CRON_SECRET" (≥ 32 chars, e.g. openssl rand -hex 32)
CRON_SECRET=

# Search engines (D126): "on" ONLY on production. Anything else (staging, previews, local) = noindex.
SITE_INDEXING=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# E-mail: outbox (dev, e-mails captured in the email_outbox table) | resend
EMAIL_TRANSPORT=outbox
# Transigo team address for carrier review and contact request notifications (D100, D110, D125)
ADMIN_NOTIFICATION_EMAIL=admin@example.com
# Contact form rate limit (D125): HMAC key for the sender's IP (≥ 32 chars, e.g. openssl rand -hex 32).
# Changing it only resets the per-IP counters.
CONTACT_IP_HASH_SECRET=generate-with-openssl-rand-hex-32
# Resend (email) — used only with EMAIL_TRANSPORT=resend (verified domain, D79). Retries: /api/cron/send-emails (D131).
RESEND_API_KEY=
# e.g. Transigo <no-reply@mail.example.it>
RESEND_FROM_EMAIL=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# E-invoicing provider (D144): demo (default; PDF with a DEMO watermark, refused on production) | fatture_in_cloud (adapter not built yet)
EINVOICE_PROVIDER=
EINVOICE_API_KEY=
EINVOICE_API_SECRET=
EINVOICE_COMPANY_ID=
EINVOICE_WEBHOOK_SECRET=
